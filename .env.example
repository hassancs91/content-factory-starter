# Content Factory — environment
#
# Copy to `.env` at the ROOT OF YOUR PROJECT (not into the skill folder) and fill in
# only what you actually use. Every one of these is optional; the tool that needs a
# missing value says so, by name, instead of failing obscurely.
#
# MAKE SURE `.env` IS GITIGNORED. `content-lab/` is committed on purpose, so a secret
# that leaks into a piece's evidence file leaks into your repository history.

# --- Lab VMs (lab/do.py) ----------------------------------------------------
# A DigitalOcean API token with write scope. Use a token dedicated to the lab, not
# your main production token: this one is allowed to destroy things.
DO_TOKEN=

# Private key used for lab boxes. `do.py ssh-key` creates and registers one for you.
CF_LAB_SSH_KEY=~/.ssh/cf_lab

# Defaults for new boxes. Keep one region so golden snapshots stay bootable.
CF_LAB_REGION=fra1
CF_LAB_SIZE=s-2vcpu-4gb

# --- Lab DNS (lab/dns.py) ---------------------------------------------------
# A Cloudflare token scoped to Zone.DNS:Edit on ONE zone.
CLOUDFLARE_LAB_DNS_TOKEN=

# The namespace lab hostnames live under. Point this at a subdomain you use for
# nothing else: `dns.py sweep --kill` deletes every record beneath it.
CF_LAB_DNS_ZONE=lab.example.com

# --- Knowledge base ---------------------------------------------------------
# Your voice, positions, and real stories. See modules/brain.md.
BRAIN_DIR=

# --- Overrides --------------------------------------------------------------
# Only if the skill does not live at <project>/.claude/skills/content-factory/
# CONTENT_FACTORY_ROOT=

# Only if 8140-8199 is busy on your machine.
# CF_PREVIEW_PORT_BASE=8140
